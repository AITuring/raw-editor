+
+fn focus_world_overlap_rect(
+    left: &ImageInfo,
+    right: &ImageInfo,
+    left_to_world: &Matrix3<f64>,
+    right_to_world: &Matrix3<f64>,
+) -> Option<stack_report::WorldRect> {
+    let bounds = |image: &ImageInfo, transform: &Matrix3<f64>| {
+        let corners = [
+            Point2::new(0.0, 0.0),
+            Point2::new(f64::from(image.width), 0.0),
+            Point2::new(f64::from(image.width), f64::from(image.height)),
+            Point2::new(0.0, f64::from(image.height)),
+        ];
+        let points = corners
+            .into_iter()
+            .filter_map(|corner| transformed_point(transform, corner))
+            .collect::<Vec<_>>();
+        (points.len() == 4).then(|| (
+            points.iter().map(|point| point.x).fold(f64::INFINITY, f64::min),
+            points.iter().map(|point| point.x).fold(f64::NEG_INFINITY, f64::max),
+            points.iter().map(|point| point.y).fold(f64::INFINITY, f64::min),
+            points.iter().map(|point| point.y).fold(f64::NEG_INFINITY, f64::max),
+        ))
+    };
+    let (left_min_x, left_max_x, left_min_y, left_max_y) = bounds(left, left_to_world)?;
+    let (right_min_x, right_max_x, right_min_y, right_max_y) = bounds(right, right_to_world)?;
+    let min_x = left_min_x.max(right_min_x);
+    let max_x = left_max_x.min(right_max_x);
+    let min_y = left_min_y.max(right_min_y);
+    let max_y = left_max_y.min(right_max_y);
+    (max_x > min_x && max_y > min_y).then_some(stack_report::WorldRect {
+        left: min_x, top: min_y, width: max_x - min_x, height: max_y - min_y,
+    })
+}
