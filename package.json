{
  "name": "raw-editor",
  "version": "0.1.0",
  "description": "A cross-platform, non-destructive RAW photo editor.",
  "author": "AITuring contributors",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/AITuring/raw-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AITuring/raw-editor.git"
  },
  "bugs": {
    "url": "https://github.com/AITuring/raw-editor/issues"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "start": "tauri dev",
    "version:set": "node scripts/set-version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "color-contract:check": "node tests/color-contract-boundary.mjs",
    "crop-transform:check": "node tests/crop-transform-contract.mjs",
    "local-only:check": "node tests/local-only-boundary.mjs",
    "preview-transport:check": "node tests/preview-transport-boundary.mjs",
    "preview-resolution:check": "node tests/preview-resolution.mjs",
    "render-strategy:check": "node tests/render-strategy-boundary.mjs",
    "watermark-contract:check": "node tests/watermark-contract.mjs",
    "synthetic-export:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_streaming_export_harness -- --ignored --nocapture",
    "synthetic-webp:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_webp_output_harness -- --ignored --nocapture",
    "synthetic-geometry:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_geometry_source_harness -- --ignored --nocapture",
    "synthetic-mask:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_mask_cache_ownership_harness -- --ignored --nocapture",
    "synthetic-mask-compose:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_mask_composition_scratch_harness -- --ignored --nocapture",
    "synthetic-range-mask:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_range_mask_overlap_scratch_harness -- --ignored --nocapture",
    "synthetic-ai-mask:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_ai_mask_overlap_scratch_harness -- --ignored --nocapture",
    "synthetic-raw-handoff:bench": "cargo test --manifest-path src-tauri/Cargo.toml synthetic_60mp_raw_rgb_handoff_harness -- --ignored --nocapture",
    "gpu-mask:check": "cargo test --manifest-path src-tauri/Cargo.toml tiled_mask_gpu_sampling_matches_source_pixels_across_tile_boundary -- --ignored --nocapture",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci --dry-run && npm run i18n:runtime-check && npm run i18n:language-check",
    "i18n:language-check": "node src/i18n/check-language-resolution.mjs",
    "i18n:runtime-check": "node src/i18n/check-runtime.mjs",
    "i18n:lint": "i18next-cli lint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@uiw/color-convert": "^2.10.3",
    "@uiw/react-color-wheel": "^2.10.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.4",
    "konva": "^10.3.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-image-crop": "^11.1.2",
    "react-konva": "^19.2.5",
    "react-toastify": "^11.1.0",
    "react-window": "^2.2.7",
    "simple-icons": "^16.25.0",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react": "^7.37.5",
    "i18next-cli": "^1.65.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@swc/core@1.15.43": true
  }
}
