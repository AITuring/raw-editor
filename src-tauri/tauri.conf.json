{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAW Editor",
  "identifier": "io.github.AITuring.RawEditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RAW Editor",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/thumbnails/*", "$APPDATA/watermarks/*"]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AITuring",
    "homepage": "https://github.com/AITuring/raw-editor",
    "copyright": "Copyright © 2026 RAW Editor contributors",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "shortDescription": "A cross-platform, non-destructive RAW photo editor.",
    "longDescription": "RAW Editor provides a fast, non-destructive photography workflow with GPU-accelerated previews and cross-platform desktop support.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources", "lensfun_db"],
    "category": "Photography",
    "fileAssociations": [
      {
        "ext": [
          "dng",
          "pro",
          "ari",
          "crw",
          "cr2",
          "cr3",
          "bay",
          "raw",
          "erf",
          "raf",
          "3fr",
          "fff",
          "iiq",
          "kdc",
          "k25",
          "dcs",
          "dcr",
          "mos",
          "rwl",
          "mef",
          "mrw",
          "nef",
          "nrw",
          "orf",
          "rw2",
          "pef",
          "ptx",
          "srw",
          "x3f",
          "arw",
          "srf",
          "sr2",
          "jpg",
          "jpeg",
          "png",
          "gif",
          "bmp",
          "tiff",
          "tif",
          "exr",
          "qoi"
        ],
        "name": "Image",
        "description": "Image file",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "version": "0.1.0"
}
